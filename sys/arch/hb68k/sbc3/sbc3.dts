/dts-v1/;

/memreserve/ 0x00000000 0x00001000;     /* ROM Overlay */

/ {
	interrupt-parent = <&intc>;
	#address-cells = <1>;
	#size-cells = <1>;

	model = "SBC3";
	compatible = "homebrew,sbc3";

	chosen {
		/*
		 * Original Wrap030 port hard-codes:
		 * RB_ASKNAME | RB_SINGLE | AB_VERBOSE | AB_DEBUG
		 */
		bootargs = "-asvx";
		stdout-path = "serial0:230400n8";
        netbsd,hardclock = "timer0";    // What is this?
	};

	aliases {
		ata0 = "/obio/ata@80200000";

		serial0 = "/obio/serial@ad0001";
		// serial1 = "/obio/serial@80300008";

		timer0 = "/obio/timer@af0001";
        ata0 = "/obio/at@ae0000";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "motorola,68030";
			device_type = "cpu";
			reg = <0>;
			clock-frequency = <40000000>;
		};
	};

	clocks {
        // 10MHz clock feeding the PIT
        pit_osc: osc10M_clk {
            compatible = "fixed-clock";
            clock-frequency = <10000000>;
        }
	};

	memory@0 {
		device_type = "memory";
        /*
         * I'm running with 4MB until I get my memory back
         * from Steve. 4MB is just about enough for proof
         * of life, nothing more.
         */
		reg = <0x0 0x400000>;       // 4MB
		#reg = <0x0 0x800000>;       // 8MB
		#reg = <0x0 0x1000000>;      // 16MB
	};

	intc: interrupt-controller {
		/*
		 * Interrupt cells:
		 * - Interrupt priority level (1-7)
		 * - Interrupt vector (0 == auto-vector)
		 */
		compatible = "motorola,68000-generic-interrupts";
		interrupt-controller;
		#interrupt-cells = <2>;
	};

	obio {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;

        timer@af0001 {
			compatible = "motorola,pit-timer";
			reg = <0xaf0001 0x40>;
            reg-shift = <1>;
			clocks = <&pit_osc>;
			interrupts = <1 0x40>;
            motorola,clock-mode = <0>;  // What is this???
		};

        duart@ad0001 {
            compatible = "exar,xr68c681";
            clock-frequency = <7372800>;
            #compatible = "motorola,mc68681";
            #clock-frequency = <3686400>;
            reg = <ad0001 0x20>;
            reg-shift = <1>;
            interrupts = <2 0x41>;
            motorola,console-channel = <0>;
        }

		ata@ae0000 {
			compatible = "ata-generic";
			#reg = <0x80200000 0x10>,	/* command */
			#      <0x8020200c 0x4>;		/* control */
            reg = <0xae0000 0x10>;
			reg-shift = <1>;
            /* 
             * I'm looking at a mod to the board to pass INTRQ
             * through to the cpu via IRQ4, but haven't done it yet.
             * I thought that being retired meant I'd have more time
             * for stuff like this - ha!
             */
			#interrupts = <4 0>;
			ata-generic,use16bit;
		};

	};
};
