# $NetBSD$
#
# SBC3 machine description file
#
# Homebrew 68030 SBC: 40 MHz 68030, 8 MB RAM at $0, ROM at $C00000,
# XR68C681 (or MC68681) DUART at $AD0001, CompactFlash at $AE0000,
# MC68230 PI/T at $AF0001.
#

include 	"arch/hb68k/conf/std.hb68k"
options 	M68030
options 	CONFIG_MACH_SBC3
options 	CONFIG_FDT_BOOTSTRAP
options 	CONFIG_STATIC_DEVICE_TREE
makeoptions	STATIC_DEVICE_TREE="${HB68K}/sbc3/sbc3.dts"

# The kernel links at the hb68k default of $2000, clear of the ROM
# vector overlay at $0-$7.  The ROM monitor must load the raw binary
# (netbsd.bin) at $2000 and jump to $2000.
#makeoptions	TEXTADDR=2000

# Reserve symbol space and copy the symbol table into it, since the
# ROM monitor won't load symbols for us.  Costs ~340 KB of RAM; leave
# it off while SBC3 is short of memory (DDB then shows bare addresses).
#makeoptions	COPY_SYMTAB=1

#options 	INCLUDE_CONFIG_FILE	# embed config file in kernel binary

#ident 		"SBC3-$Revision$"

maxusers	8

options 	DDB		# in-kernel debugger
#options 	DIAGNOSTIC	# extra sanity checks (costs RAM)
#options 	LOCKDEBUG
#options 	DEBUG

options 	PIPE_SOCKETPAIR	# smaller, but slower pipe(2)

# No 68881/68882 on SBC3: emulate the FPU in the kernel.
options 	FPU_EMULATE

file-system 	FFS		# Berkeley Fast File System
#file-system 	MSDOSFS		# MS-DOS File System (FAT)
options 	FFS_NO_SNAPSHOT	# No FFS snapshot support

options 	INET		# IPv4

# Memory savers for a 4-8 MB machine: no loadable modules, no RAM
# disk, and a smaller buffer cache (default is 15% of RAM).
no options 	MODULAR
no options 	MODULAR_DEFAULT_AUTOLOAD
no pseudo-device	md
no options 	MEMORY_DISK_HOOKS
no options 	MEMORY_DISK_DYNAMIC
options 	BUFCACHE=5

## "generic" boot (put root on boot device)
config netbsd		root on ? type ?

pseudo-device	loop
pseudo-device	pty			# pseudo-terminals
pseudo-device	ksyms			# /dev/ksyms

# Generic m68k interrupts.
genintc*	at fdt? pass 2

# System timer (MC68230 PI/T)
pittmr*		at fdt? pass 3

# On-board serial ports (MC68681 / XR68C681 DUART)
duart*		at fdt? pass 5

# CompactFlash, 8-bit True IDE, polled
wdc*		at fdt?
atabus*		at ata?
wd*		at atabus? drive?
